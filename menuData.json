/**
 * ROCCO — مدل داده‌ی منو (شی‌گرا و قابل توسعه)
 *
 * افزودن بخش جدید:
 *   const menu = createMenu();
 *   menu.addCategory(new MenuCategory({ id: 'shisha', title: 'قلیان', latin: 'HOOKAH', accent: NEON.green, items: [...] }));
 *
 * افزودن محصول به یک بخش:
 *   menu.addItem('hot', new MenuItem({ id: 'ris', name: 'ریستریتو', price: 85000 }));
 *
 * حذف:
 *   menu.removeItem('hot', 'espresso');   menu.removeCategory('tea');
 *
 * برای ذخیره‌ی ساختار فعلی (مثلاً روی سرور) از menu.toConfig() استفاده کن.
 */

export const ALL_FILTER = 'همه';

/** پالت‌های نئونی آماده — هر بخش یکی از این‌ها را می‌گیرد */
export const NEON = {
  amber: { key: 'amber', name: 'کهربایی', primary: '#FFC107', rgb: '255 193 7' },
  cyan: { key: 'cyan', name: 'فیروزه‌ای', primary: '#00E5FF', rgb: '0 229 255' },
  violet: { key: 'violet', name: 'بنفش', primary: '#A78BFA', rgb: '167 139 250' },
  emerald: { key: 'emerald', name: 'زمرد', primary: '#34D399', rgb: '52 211 153' },
  pink: { key: 'pink', name: 'سرخابی', primary: '#FF2D55', rgb: '255 45 85' },
  lime: { key: 'lime', name: 'لیمویی', primary: '#A3E635', rgb: '163 230 53' },
};

export class MenuItem {
  constructor({ id, name, latin = '', description = '', price = 0, tags = [], featured = false }) {
    this.id = id;
    this.name = name;
    this.latin = latin;
    this.description = description;
    this.price = price;
    this.tags = [...tags];
    this.featured = featured;
  }

  addTag(tag) {
    if (!this.tags.includes(tag)) this.tags.push(tag);
    return this;
  }

  removeTag(tag) {
    this.tags = this.tags.filter((t) => t !== tag);
    return this;
  }

  hasTag(tag) {
    return this.tags.includes(tag);
  }

  update(patch = {}) {
    Object.assign(this, patch);
    return this;
  }
}

export class MenuCategory {
  constructor({ id, title, latin = '', tagline = '', icon = 'Coffee', accent = NEON.amber, filters = [], items = [] }) {
    this.id = id;
    this.title = title;
    this.latin = latin;
    this.tagline = tagline;
    this.icon = icon;
    this.accent = accent;
    this.filters = [...filters];
    this.items = items.map((item) => (item instanceof MenuItem ? item : new MenuItem(item)));
  }

  addItem(item) {
    this.items.push(item instanceof MenuItem ? item : new MenuItem(item));
    return this;
  }

  removeItem(itemId) {
    this.items = this.items.filter((i) => i.id !== itemId);
    return this;
  }

  updateItem(itemId, patch) {
    const found = this.items.find((i) => i.id === itemId);
    if (found) found.update(patch);
    return this;
  }

  /** فیلتر بر اساس برچسب؛ ALL_FILTER همه‌ی آیتم‌ها را برمی‌گرداند */
  filterBy(tag = ALL_FILTER) {
    if (!tag || tag === ALL_FILTER) return this.items;
    return this.items.filter((item) => item.hasTag(tag));
  }
}

export class MenuEngine {
  constructor({ cafe = {}, categories = [] } = {}) {
    this.cafe = cafe;
    this.categories = categories.map((c) => (c instanceof MenuCategory ? c : new MenuCategory(c)));
  }

  addCategory(category) {
    this.categories.push(category instanceof MenuCategory ? category : new MenuCategory(category));
    return this;
  }

  removeCategory(id) {
    this.categories = this.categories.filter((c) => c.id !== id);
    return this;
  }

  getCategory(id) {
    return this.categories.find((c) => c.id === id);
  }

  addItem(categoryId, item) {
    this.getCategory(categoryId)?.addItem(item);
    return this;
  }

  removeItem(categoryId, itemId) {
    this.getCategory(categoryId)?.removeItem(itemId);
    return this;
  }

  totalItems() {
    return this.categories.reduce((sum, c) => sum + c.items.length, 0);
  }

  toConfig() {
    return { cafe: this.cafe, categories: this.categories };
  }
}

